/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  X-Content-Type-Options: nosniff

/api/seo/*
  Content-Type: application/xml; charset=utf-8

# 静的画像アセット（30日間キャッシュ）
/img/*
  Cache-Control: public, max-age=2592000, immutable
  X-Content-Type-Options: nosniff

/favicon.*
  Cache-Control: public, max-age=2592000, immutable

# CSS & JavaScript（1日間キャッシュ）
/css/*
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff

/js/*
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff
